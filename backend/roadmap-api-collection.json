              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Roadmap retrieved successfully\",\n  \"data\": {\n    \"id\": \"uuid-here\",\n    \"slug\": \"frontend\",\n    \"title\": \"Frontend Developer\",\n    \"description\": \"Step by step guide to becoming a frontend developer\",\n    \"source_url\": \"https://roadmap.sh/frontend\",\n    \"version\": 1,\n    \"node_count\": 45\n  }\n}"
            }
