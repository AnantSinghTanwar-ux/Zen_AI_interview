              "body": "{\n  \"success\": true,\n  \"message\": \"Roadmap nodes and edges retrieved successfully\",\n  \"data\": {\n    \"roadmap\": {\n      \"id\": \"uuid-here\",\n      \"slug\": \"frontend\",\n      \"title\": \"Frontend Developer\"\n    },\n    \"nodes\": [\n      {\n        \"id\": \"uuid-here\",\n        \"slug\": \"html\",\n        \"title\": \"HTML\",\n        \"type\": \"topic\",\n        \"parent_id\": null\n      }\n    ],\n    \"edges\": [\n      {\n        \"id\": \"uuid-here\",\n        \"source_node_id\": \"uuid-1\",\n        \"target_node_id\": \"uuid-2\"\n      }\n    ]\n  }\n}"
