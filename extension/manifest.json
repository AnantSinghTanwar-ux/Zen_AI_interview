{
  "manifest_version": 3,
  "name": "ZenAI Job Fit Analyzer",
  "description": "Detect job listings and analyze resume fit instantly with ZenAI.",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.jobyt.com/*",
    "*://*.indeed.com/*",
    "*://*.naukri.com/*",
    "*://*.glassdoor.com/*",
    "*://*.monster.com/*",
    "*://*.wellfound.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.jobs.*/*",
    "*://*.careers.*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ZenAI",
    "default_popup": "popup.html"
  }
}
